# Avalena — Apache konfiguracija za prerenderiranu Angular stranicu

DirectoryIndex index.html
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.avalena.hr -> avalena.hr (jedna verzija stranice za tražilice)
  RewriteCond %{HTTP_HOST} ^www\.avalena\.hr$ [NC]
  RewriteRule ^ https://avalena.hr%{REQUEST_URI} [R=301,L]

  # /smjestaj/residence/ -> /smjestaj/residence (bez kose crte na kraju)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Prerenderirana stranica: /smjestaj/residence -> /smjestaj/residence/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # Mape bez stranice (npr. /smjestaj ili /en/accommodation) -> 404
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^ - [R=404,L]
</IfModule>

# Nepostojeće adrese vraćaju status 404 (ne naslovnicu), a stranicu
# "nije pronađeno" na odgovarajućem jeziku prikazuje Angular.
ErrorDocument 404 /index.csr.html
